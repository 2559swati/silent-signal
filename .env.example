DATABASE_URL=postgresql://postgres:password@postgres:5432/silentsignal
POSTGRES_DB=silentsignal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
TEE_MODE=demo
# Phase 12 Nitro Enclave (local default: loopback transport, no hardware).
# Production on a Nitro EC2 parent: TEE_MODE=nitro, NITRO_TRANSPORT=vsock.
NITRO_TRANSPORT=loopback
NITRO_CID=16
NITRO_PORT=5000
# Fernet data key for the telemetry envelope (generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())').
# Unset -> ephemeral process-local key (local dev/tests only).
NITRO_DATA_KEY=
# UNVERIFIED PCR0 placeholder (never reported as attested; Phase 13 pins
# the real approved-EIF PCR0 in infra/kms-key-policy.json instead).
NITRO_PCR0=
# Phase 13 KMS (parent-side only; requires AWS KMS + Nitro hardware).
KMS_KEY_ID=
KMS_REGION=
