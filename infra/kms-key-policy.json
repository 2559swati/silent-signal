{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnableRootAdmin",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:root"
      },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "EnableEnclaveDataProcessing",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/silentsignal-nitro-parent"
      },
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "kms:RecipientAttestation:PCR0": "REPLACE_WITH_REAL_PCR0_FROM_APPROVED_EIF_SEE_infra_README-attestation.md",
          "kms:RecipientAttestation:ImageSha384": "REPLACE_WITH_REAL_PCR0_FROM_APPROVED_EIF_SEE_infra_README-attestation.md"
        }
      }
    }
  ]
}
